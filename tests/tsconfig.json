{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "noEmit": true,
    "types": ["node"],
    "typeRoots": [
      "../packages/agents/node_modules/@types",
      "../node_modules/@types"
    ],
    "customConditions": ["development"],
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": false
  },
  "include": ["**/*.ts"],
  "exclude": ["fixtures/**"]
}
