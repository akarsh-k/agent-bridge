{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "@ecommerce/shared": ["../ecommerce-shared/src/index.ts"],
      "@ecommerce/shared/*": ["../ecommerce-shared/src/*"]
    }
  },
  "include": ["src"]
}
