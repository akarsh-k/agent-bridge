{
  "name": "worker",
  "version": "1.0.0",
  "private": true,
  "description": "Background worker for Agent Bridge — BullMQ queues for clone/index/wiki jobs.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "NODE_OPTIONS='--conditions=development' tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "author": "Akarsh K (https://github.com/akarsh-k)",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akarsh-k/agent-bridge.git",
    "directory": "apps/worker"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@agent-bridge/db": "workspace:*",
    "@agent-bridge/shared": "workspace:*",
    "bullmq": "^5.76.2",
    "gitnexus": "1.6.5",
    "ioredis": "^5.10.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
