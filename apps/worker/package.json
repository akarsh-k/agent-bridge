{
  "name": "worker",
  "version": "1.0.0",
  "private": true,
  "description": "Background worker for Agent Bridge — BullMQ queues for clone/index/wiki jobs.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@agent-bridge/shared": "workspace:*",
    "bullmq": "^5.76.2",
    "gitnexus": "1.6.3",
    "ioredis": "^5.10.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
