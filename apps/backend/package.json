{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "Hono backend for Agent Bridge — agent control plane, run dispatcher, and bridge endpoints.",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./src/app.ts",
  "exports": {
    ".": {
      "types": "./src/app.ts",
      "development": "./src/app.ts",
      "import": "./dist/app.js",
      "default": "./dist/app.js"
    }
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--conditions=development' tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "author": "Akarsh K (https://github.com/akarsh-k)",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akarsh-k/agent-bridge.git",
    "directory": "apps/backend"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@agent-bridge/agents": "workspace:*",
    "@agent-bridge/db": "workspace:*",
    "@agent-bridge/shared": "workspace:*",
    "@hono/node-server": "^2.0.0",
    "@hono/zod-validator": "^0.7.6",
    "bullmq": "^5.76.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.15",
    "ioredis": "^5.10.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  }
}
