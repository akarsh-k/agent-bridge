# ─── Backend API (apps/backend) ─────────────────────────────────────────────
NODE_ENV=development
# Bind to loopback for local dev. Use 0.0.0.0 only inside a container / when
# you deliberately want LAN access and a proxy / firewall in front.
HOST=127.0.0.1
PORT=3001
# Comma-separated list of allowed origins. Required in production.
# Never use "*" in production — the app will refuse to start.
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# ─── Frontend (apps/frontend) ───────────────────────────────────────────────
# Only VITE_* is exposed to the browser bundle.
#
# Leave VITE_API_URL UNSET for the standard install:
#   - `pnpm start` (production): the backend serves the frontend bundle, so
#     same-origin relative requests (`/api/...`) work without CORS.
#   - `pnpm dev`: the frontend defaults to `http://127.0.0.1:3001` to reach
#     the backend across Vite's 5173 dev origin.
# Set it ONLY if you're deploying the frontend on a separate origin from the
# backend (different host / port / scheme). Must be an absolute URL when set,
# and HTTPS in production unless you also override the secure-headers config.
# VITE_API_URL=https://api.example.com

# ─── Postgres (docker-compose, pgvector) ────────────────────────────────────
POSTGRES_USER=agentbridge
# CHANGE THIS before deploying anywhere non-local.
POSTGRES_PASSWORD=agentbridge_dev_password
POSTGRES_DB=agentbridge
# The host port is bound to loopback by POSTGRES_BIND so the DB is not on the LAN.
POSTGRES_PORT=5432
POSTGRES_BIND=127.0.0.1
DATABASE_URL=postgresql://agentbridge:agentbridge_dev_password@127.0.0.1:5432/agentbridge

# ─── Redis (docker-compose) ─────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_BIND=127.0.0.1
REDIS_URL=redis://127.0.0.1:6379

# ─── Worker (apps/worker) ───────────────────────────────────────────────────
# Max concurrent BullMQ jobs per worker process. Bump for parallel indexing.
WORKER_CONCURRENCY=4

# ─── Diagnostics (optional) ─────────────────────────────────────────────────
# Logs every Drizzle SQL statement to stderr. Verbose; dev-only — refuses to
# log when NODE_ENV=production even if set.
# DATABASE_DEBUG=false

# ─── Isolation: data root ───────────────────────────────────────────────────
# Every persistent artifact — cloned repos, GitNexus knowledge graphs, wiki
# output, the secrets master key — lives under this single directory. Default
# is `<repo>/.agent-bridge-data/`. Override to relocate (e.g. onto a faster
# disk, or when running multiple agent-bridge instances side by side).
# AGENT_BRIDGE_DATA_DIR=/absolute/path/to/.agent-bridge-data

# ─── Isolation: secrets master key ──────────────────────────────────────────
# Base64url-encoded 32-byte AES-256-GCM key. When unset, the app auto-generates
# one at `<AGENT_BRIDGE_DATA_DIR>/secret.key` on first boot (mode 0600). Setting
# it here takes precedence and is what you want for reproducible backups —
# back up this value and every encrypted row is portable.
#
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# AGENT_BRIDGE_SECRET_KEY=

# ─── Contributor: smoke tests (optional) ────────────────────────────────────
# Only needed for `pnpm test:fixture` / `test:fixture:setup` / `test:fixture:skill`.
# The smoke harness uses a separate test DB (agentbridge_test) and data root,
# so it can't reuse providers seeded in the workspace — it needs explicit
# endpoints. See tests/README.md for the full walkthrough.
#
# Embeddings (required for test:fixture[:setup]). Output dimensionality is
# auto-probed from the endpoint at preflight — no need to declare it.
# SMOKE_EMBEDDING_URL=https://api.openai.com/v1
# SMOKE_EMBEDDING_MODEL=text-embedding-3-small
# SMOKE_EMBEDDING_API_KEY=
#
# Chat (required for test:fixture:skill, which invokes the model, and
# for the end-to-end inspect_codebase envelope check in test:fixture:bridge).
# SMOKE_CHAT_URL=https://api.openai.com/v1
# SMOKE_CHAT_MODEL=gpt-4o-mini
# SMOKE_CHAT_API_KEY=
