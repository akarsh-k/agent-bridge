# ─── Backend API (apps/backend) ─────────────────────────────────────────────
NODE_ENV=development
# Bind to loopback for local dev. Use 0.0.0.0 only inside a container / when
# you deliberately want LAN access and a proxy / firewall in front.
HOST=127.0.0.1
PORT=3001
# Comma-separated list of allowed origins. Required in production.
# Never use "*" in production — the app will refuse to start.
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# ─── Frontend (apps/frontend) ───────────────────────────────────────────────
# Only VITE_* is exposed to the browser bundle. Must be an absolute URL.
# In production this must be your HTTPS API origin.
VITE_API_URL=http://127.0.0.1:3001

# ─── Postgres (docker-compose, pgvector) ────────────────────────────────────
POSTGRES_USER=agentbridge
# CHANGE THIS before deploying anywhere non-local.
POSTGRES_PASSWORD=agentbridge_dev_password
POSTGRES_DB=agentbridge
# The host port is bound to loopback by POSTGRES_BIND so the DB is not on the LAN.
POSTGRES_PORT=5432
POSTGRES_BIND=127.0.0.1
DATABASE_URL=postgresql://agentbridge:agentbridge_dev_password@127.0.0.1:5432/agentbridge

# ─── Redis (docker-compose) ─────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_BIND=127.0.0.1
REDIS_URL=redis://127.0.0.1:6379

# ─── Worker (apps/worker) ───────────────────────────────────────────────────
# Max concurrent BullMQ jobs per worker process. Bump for parallel indexing.
WORKER_CONCURRENCY=4

# ─── Isolation: data root ───────────────────────────────────────────────────
# Every persistent artifact — cloned repos, GitNexus knowledge graphs, wiki
# output, the secrets master key — lives under this single directory. Default
# is `<repo>/.agent-bridge-data/`. Override to relocate (e.g. onto a faster
# disk, or when running multiple agent-bridge instances side by side).
# AGENT_BRIDGE_DATA_DIR=/absolute/path/to/.agent-bridge-data

# ─── Isolation: secrets master key ──────────────────────────────────────────
# Base64url-encoded 32-byte AES-256-GCM key. When unset, the app auto-generates
# one at `<AGENT_BRIDGE_DATA_DIR>/secret.key` on first boot (mode 0600). Setting
# it here takes precedence and is what you want for reproducible backups —
# back up this value and every encrypted row is portable.
#
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# AGENT_BRIDGE_SECRET_KEY=
