{
  "name": "@agent-bridge/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared Zod schemas, types, and config helpers for Agent Bridge apps.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./env": {
      "types": "./src/env.ts",
      "development": "./src/env.ts",
      "import": "./dist/env.js",
      "default": "./dist/env.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "typescript": "~6.0.3"
  }
}
