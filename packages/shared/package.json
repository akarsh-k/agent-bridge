{
  "name": "@agent-bridge/shared",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Shared Zod schemas, types, and config helpers for Agent Bridge apps.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./env": {
      "types": "./src/env.ts",
      "development": "./src/env.ts",
      "import": "./dist/env.js",
      "default": "./dist/env.js"
    },
    "./paths": {
      "types": "./src/paths.ts",
      "development": "./src/paths.ts",
      "import": "./dist/paths.js",
      "default": "./dist/paths.js"
    },
    "./crypto": {
      "types": "./src/crypto.ts",
      "development": "./src/crypto.ts",
      "import": "./dist/crypto.js",
      "default": "./dist/crypto.js"
    },
    "./spawn": {
      "types": "./src/spawn.ts",
      "development": "./src/spawn.ts",
      "import": "./dist/spawn.js",
      "default": "./dist/spawn.js"
    },
    "./gitnexus": {
      "types": "./src/gitnexus.ts",
      "development": "./src/gitnexus.ts",
      "import": "./dist/gitnexus.js",
      "default": "./dist/gitnexus.js"
    },
    "./event-bus": {
      "types": "./src/event-bus.ts",
      "development": "./src/event-bus.ts",
      "import": "./dist/event-bus.js",
      "default": "./dist/event-bus.js"
    },
    "./queues": {
      "types": "./src/queues.ts",
      "development": "./src/queues.ts",
      "import": "./dist/queues.js",
      "default": "./dist/queues.js"
    },
    "./version": {
      "types": "./src/version.ts",
      "development": "./src/version.ts",
      "import": "./dist/version.js",
      "default": "./dist/version.js"
    },
    "./git-remote": {
      "types": "./src/git-remote.ts",
      "development": "./src/git-remote.ts",
      "import": "./dist/git-remote.js",
      "default": "./dist/git-remote.js"
    },
    "./embedder-probe": {
      "types": "./src/embedder-probe.ts",
      "development": "./src/embedder-probe.ts",
      "import": "./dist/embedder-probe.js",
      "default": "./dist/embedder-probe.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "author": "Akarsh K (https://github.com/akarsh-k)",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akarsh-k/agent-bridge.git",
    "directory": "packages/shared"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "ioredis": "^5.10.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "typescript": "~6.0.3"
  }
}
