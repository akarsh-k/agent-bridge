{
  "name": "@agent-bridge/agents",
  "version": "1.0.0",
  "private": true,
  "description": "Mastra-backed agent factory. Builds a configured Agent from a DB row (system prompt, model, memory, tools) so apps/backend + apps/worker can run it without touching Mastra directly. This is the ONLY package allowed to import @mastra/* (enforced by the root ESLint guard rail).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').cpSync('src/inspector/system-prompt.md', 'dist/src/inspector/system-prompt.md')\"",
    "dev": "tsc --watch --preserveWatchOutput",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "smoke": "NODE_OPTIONS='--conditions=development' tsx scripts/smoke.ts",
    "smoke:gitnexus-query": "NODE_OPTIONS='--conditions=development' tsx scripts/smoke-gitnexus-query.ts",
    "smoke:keyword-search": "NODE_OPTIONS='--conditions=development' tsx scripts/smoke-keyword-search.ts"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@agent-bridge/db": "workspace:*",
    "@agent-bridge/shared": "workspace:*",
    "@mastra/core": "^1.28.0",
    "@mastra/mcp": "^1.5.2",
    "@mastra/memory": "^1.17.1",
    "@mastra/pg": "^1.9.2",
    "@vscode/ripgrep": "^1.18.0",
    "drizzle-orm": "^0.45.2",
    "gitnexus": "1.6.4",
    "js-tiktoken": "^1.0.21",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/pg": "^8.20.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
